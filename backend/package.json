{
  "name": "vehicle-tracking-backend",
  "version": "0.1.0",
  "description": "Vehicle Tracking System — Phase 1 backend",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:schema:create": "tsx src/database/create-schema.ts",
    "db:schema:sql": "tsx src/database/dump-schema.ts"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.2",
    "@mikro-orm/postgresql": "^7.2.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.12",
    "@swc/jest": "^0.2.39",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
