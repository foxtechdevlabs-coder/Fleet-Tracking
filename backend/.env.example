NODE_ENV=development
PORT=3000
# Comma-separated list of exact HTTP(S) origins allowed by CORS.
FRONTEND_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
# disable | require (default: encrypted, certificate not verified) | verify-full
DATABASE_SSL=require
# verify-full only: path to the server's CA certificate, relative to backend/
# (e.g. ./certs/prod-ca-2021.crt for Supabase). Must be empty for other modes.
DATABASE_SSL_CA=
# At least 32 bytes. Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=


ADMIN_EMAIL=Admin_Email
ADMIN_NAME=Admin_Name
ADMIN_PASSWORD=Admin_Password
# admin | super_admin
ADMIN_ROLE=super_admin
