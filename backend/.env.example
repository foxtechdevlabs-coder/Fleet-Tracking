# development | test | production. Defaults to production when unset (no SQL logging).
# development logs SQL statements with ? placeholders only, never parameter values.
NODE_ENV=development
PORT=3000
# Comma-separated list of exact HTTP(S) origins allowed by CORS.
FRONTEND_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
# Production requires verify-full; require encrypts without certificate verification.
# disable | require | verify-full
DATABASE_SSL=require
# verify-full only: path to the server's CA certificate, relative to backend/
# (e.g. ./certs/prod-ca-2021.crt for Supabase). Must be empty for other modes.
DATABASE_SSL_CA=
# Requests per minute per client IP (optional; defaults shown). Over the limit -> 429.
# API_RATE_LIMIT_PER_MINUTE covers /api/* except health checks and GPS ingest,
# which has its own, higher INGEST_RATE_LIMIT_PER_MINUTE.
API_RATE_LIMIT_PER_MINUTE=300
INGEST_RATE_LIMIT_PER_MINUTE=1200
# At least 32 bytes. Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=


ADMIN_EMAIL=Admin_Email
ADMIN_NAME=Admin_Name
ADMIN_PASSWORD=Admin_Password
# admin | super_admin
ADMIN_ROLE=super_admin
# Optional initial-seed credentials; if either is set, set both.
# ADMIN_INITIAL_EMAIL=
# ADMIN_INITIAL_PASSWORD=
